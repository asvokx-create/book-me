name: book-me
region: sfo

services:
  - name: web
    github:
      repo: YOUR_GITHUB_USERNAME/book-me
      branch: main
      deploy_on_push: true
    # The buildpack reads the exact patched Node.js version from package.json.
    environment_slug: node-js
    instance_size_slug: apps-s-1vcpu-1gb-fixed
    instance_count: 1
    build_command: npm ci && npm run build
    run_command: npm start
    http_port: 8080
    envs:
      - key: NODE_ENV
        value: production
        scope: RUN_AND_BUILD_TIME
      - key: PORT
        value: "8080"
        scope: RUN_TIME
      - key: DATABASE_URL
        value: ${bookme-db.DATABASE_PRIVATE_URL}
        scope: RUN_TIME
        type: SECRET
      - key: DATABASE_CA_CERT
        value: ${bookme-db.CA_CERT}
        scope: RUN_TIME
        type: SECRET
      - key: BETTER_AUTH_URL
        value: ${APP_URL}
        scope: RUN_AND_BUILD_TIME
      - key: NEXT_PUBLIC_APP_URL
        value: ${APP_URL}
        scope: RUN_AND_BUILD_TIME
      - key: BETTER_AUTH_SECRET
        value: REPLACE_IN_DIGITALOCEAN
        scope: RUN_TIME
        type: SECRET
      # Use the same long random value in the payment-releases job below.
      # This is never sent to browsers.
      - key: CRON_SECRET
        value: REPLACE_WITH_A_LONG_RANDOM_SECRET
        scope: RUN_TIME
        type: SECRET
      - key: AFFILIATE_RESERVE_BUFFER_CENTS
        value: "0"
        scope: RUN_TIME
      - key: PROTECTED_OWNER_PAYOUTS_ENABLED
        value: "true"
        scope: RUN_TIME
      - key: OWNER_PAYOUT_MINIMUM_CENTS
        value: "100"
        scope: RUN_TIME
      # Jarvis phone secrets belong only on the web service. Add them through
      # DigitalOcean's encrypted environment settings, never in this file.
      - key: JARVIS_TWILIO_WEBHOOK_BASE_URL
        value: https://bubsbookings.com
        scope: RUN_TIME
      - key: JARVIS_MAX_OUTBOUND_CALLS_PER_DAY
        value: "10"
        scope: RUN_TIME
      # Create this as a dedicated OpenAI Agents API environment without
      # production secrets or deploy credentials.
      - key: JARVIS_CODEX_ENVIRONMENT_ID
        value: REPLACE_WITH_OPENAI_HOSTED_ENVIRONMENT_ID
        scope: RUN_TIME
      - key: JARVIS_CODEX_MODEL
        value: gpt-6-luna
        scope: RUN_TIME
      - key: JARVIS_CODEX_SPEND_LIMIT_CENTS
        value: "100"
        scope: RUN_TIME

jobs:
  # One scheduled component handles booking reminders and the protected payout
  # workflow. Reuse this component instead of adding a second paid job.
  - name: scheduled-operations
    github:
      repo: YOUR_GITHUB_USERNAME/book-me
      branch: main
      deploy_on_push: true
    # This scheduled component uses the same package.json runtime pin as web.
    environment_slug: node-js
    instance_size_slug: apps-s-1vcpu-0.5gb
    build_command: npm ci
    run_command: node scripts/trigger-scheduled-operations.mjs
    kind: SCHEDULED
    schedule:
      cron: "*/15 * * * *"
      time_zone: America/Los_Angeles
    envs:
      - key: SCHEDULED_CRON_ORIGIN
        value: https://bubsbookings.com
        scope: RUN_TIME
      # Must exactly match the CRON_SECRET stored on the web service.
      - key: CRON_SECRET
        value: REPLACE_WITH_A_LONG_RANDOM_SECRET
        scope: RUN_TIME
        type: SECRET

databases:
  - name: bookme-db
    engine: PG
    version: "17"
    production: false
