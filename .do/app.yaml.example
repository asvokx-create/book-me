name: book-me
region: sfo

services:
  - name: web
    github:
      repo: YOUR_GITHUB_USERNAME/book-me
      branch: main
      deploy_on_push: true
    environment_slug: node-js
    instance_size_slug: apps-s-1vcpu-1gb-fixed
    instance_count: 1
    build_command: npm ci && npm run build
    run_command: npm start
    http_port: 8080
    envs:
      - key: NODE_ENV
        value: production
        scope: RUN_AND_BUILD_TIME
      - key: PORT
        value: "8080"
        scope: RUN_TIME
      - key: DATABASE_URL
        value: ${bookme-db.DATABASE_PRIVATE_URL}
        scope: RUN_TIME
        type: SECRET
      - key: BETTER_AUTH_URL
        value: ${APP_URL}
        scope: RUN_AND_BUILD_TIME
      - key: NEXT_PUBLIC_APP_URL
        value: ${APP_URL}
        scope: RUN_AND_BUILD_TIME
      - key: BETTER_AUTH_SECRET
        value: REPLACE_IN_DIGITALOCEAN
        scope: RUN_TIME
        type: SECRET

databases:
  - name: bookme-db
    engine: PG
    version: "17"
    production: false
