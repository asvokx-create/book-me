{
  "name": "book-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/setup-marketplace-db.mjs && next start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint",
    "db:auth": "npx auth@latest migrate --yes --config ./lib/auth.ts",
    "db:marketplace": "node scripts/setup-marketplace-db.mjs",
    "db:setup": "npm run db:auth && npm run db:marketplace",
    "sandbox:affiliate": "node --experimental-strip-types scripts/run-affiliate-sandbox.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "better-auth": "^1.7.7",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
