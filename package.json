{
  "name": "book-me",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "prestart": "node scripts/verify-node-runtime.mjs",
    "start": "node scripts/setup-marketplace-db.mjs && next start",
    "security:node-runtime": "node scripts/verify-node-runtime.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint",
    "db:auth": "npx auth@latest migrate --yes --config ./lib/auth.ts",
    "db:marketplace": "node scripts/setup-marketplace-db.mjs",
    "db:setup": "npm run db:auth && npm run db:marketplace",
    "sandbox:affiliate": "node --experimental-strip-types scripts/run-affiliate-sandbox.ts",
    "test:booking-fee-migration": "node scripts/test-booking-fee-migration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "better-auth": "^1.7.2",
    "next": "16.4.3",
    "openai": "^7.38.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.2.0",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
