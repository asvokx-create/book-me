DATABASE_URL=postgresql://user:password@host:25060/defaultdb
DATABASE_CA_CERT=
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google Analytics measurement ID (starts with G-) and Search Console HTML-tag value
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
# Social sign-in. Production callbacks:
# https://bubsbookings.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-only Google Places API key for admin-reviewed provider discovery.
# Restrict the key to Places API (New); do not expose it in NEXT_PUBLIC_* variables.
GOOGLE_MAPS_PLACES_API_KEY=
# Comma-separated login emails allowed to open /admin
BOOKME_ADMIN_EMAILS=owner@example.com
# Turn on only after every admin has enabled an authenticator in Account > Security.
BOOKME_REQUIRE_ADMIN_2FA=false

# Admin-only, read-only Jarvis operations assistant. Both values stay server-side.
# Choose a supported Responses API model and set conservative daily usage caps.
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-6-luna
JARVIS_DAILY_REQUEST_LIMIT=100
JARVIS_DAILY_TOKEN_LIMIT=100000
# Approval-gated Codex repair tasks. Create a dedicated OpenAI hosted Agents API
# environment for this repository. Do not give it production secrets or deploy access.
JARVIS_CODEX_ENVIRONMENT_ID=
JARVIS_CODEX_MODEL=gpt-6-luna
# Maximum spend for one approved task, in cents.
JARVIS_CODEX_SPEND_LIMIT_CENTS=100
# Jarvis phone. All values are server-only. Use a separate Twilio API key for
# production REST calls when supported by the selected Twilio product.
OPENAI_WEBHOOK_SECRET=whsec_your_openai_webhook_secret
OPENAI_PROJECT_ID=proj_your_openai_project_id
JARVIS_VOICE_MODEL=gpt-live-1
# Used only if the OpenAI project still emits the legacy Realtime SIP event.
JARVIS_REALTIME_VOICE_MODEL=gpt-realtime-2.1
JARVIS_PHONE_CODE_SECRET=replace-with-a-separate-long-random-secret
JARVIS_TWILIO_WEBHOOK_BASE_URL=https://bubsbookings.com
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+14255550100
JARVIS_ALERT_PHONE_E164=+14255550101
# Cost guard. Zero disables all outbound incident calls.
JARVIS_MAX_OUTBOUND_CALLS_PER_DAY=10

# Transactional email and scheduled appointment reminders
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="BubsBookings <updates@your-domain.com>"
CRON_SECRET=replace-with-a-long-random-secret
# DigitalOcean scheduled job only. Use the site's HTTPS origin, without a path.
SCHEDULED_CRON_ORIGIN=https://bubsbookings.com

# Provider marketing uses a separate Resend sending domain/API key so campaigns
# cannot damage the reputation pool used by password and booking emails.
RESEND_MARKETING_API_KEY=re_separate_marketing_key
MARKETING_EMAIL_FROM=campaigns@mail.your-domain.com
RESEND_MARKETING_WEBHOOK_SECRET=whsec_your_resend_marketing_webhook_secret
MARKETING_TOKEN_SECRET=replace-with-a-separate-long-random-secret
# Required before provider promotional email can be sent. Use a real business,
# PO box, or qualifying private-mailbox address. Do not invent one.
MARKETING_POSTAL_ADDRESS=""

# Admin-reviewed provider outreach. The sender must be a verified address in
# Resend. Sending stays unavailable until all of these are configured. Use a
# real business, PO box, or qualifying private-mailbox address; never invent one.
OUTREACH_EMAIL_FROM="BubsBookings <christian@bubsbookings.com>"
OUTREACH_POSTAL_ADDRESS=""
OUTREACH_TOKEN_SECRET=replace-with-a-separate-long-random-secret

# Stripe test mode: provider subscriptions, booking payments, and Connect payouts
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Extra cash to retain above unpaid affiliate earnings, in cents.
AFFILIATE_RESERVE_BUFFER_CENTS=0
# Enable only after the Stripe platform payout schedule is set to manual.
PROTECTED_OWNER_PAYOUTS_ENABLED=false
# Minimum protected owner payout, in cents. Runs on Fridays (America/Los_Angeles).
OWNER_PAYOUT_MINIMUM_CENTS=100

# DigitalOcean Spaces listing-photo storage
SPACES_REGION=sfo3
SPACES_BUCKET=your-space-name
SPACES_KEY=your-spaces-access-key
SPACES_SECRET=your-spaces-secret-key
# Optional CDN or custom base URL, without a trailing slash
SPACES_PUBLIC_URL=https://your-space-name.sfo3.cdn.digitaloceanspaces.com
