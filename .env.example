# Local PostgreSQL or your DigitalOcean Managed PostgreSQL connection string.
DATABASE_URL=postgresql://bookme:password@localhost:5432/bookme
DATABASE_CA_CERT=

# Generate a long, random value before deployment. Never expose this publicly.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: DigitalOcean Spaces for provider photos and portfolio uploads.
DO_SPACES_REGION=sfo3
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_BUCKET=bookme-uploads
DO_SPACES_KEY=
DO_SPACES_SECRET=
