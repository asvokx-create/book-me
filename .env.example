DATABASE_URL=postgresql://user:password@host:25060/defaultdb
DATABASE_CA_CERT=
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated login emails allowed to open /admin
BOOKME_ADMIN_EMAILS=owner@example.com

# Transactional email and scheduled appointment reminders
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="BookMe <updates@your-domain.com>"
CRON_SECRET=replace-with-a-long-random-secret

# DigitalOcean Spaces listing-photo storage
SPACES_REGION=sfo3
SPACES_BUCKET=your-space-name
SPACES_KEY=your-spaces-access-key
SPACES_SECRET=your-spaces-secret-key
# Optional CDN or custom base URL, without a trailing slash
SPACES_PUBLIC_URL=https://your-space-name.sfo3.cdn.digitaloceanspaces.com
